# dolphin-maps' account housekeeping, on a schedule: every 15 minutes EventBridge POSTs to the production site's
# /api/housekeeping, which revokes the Apple tokens of deleted accounts (retried until Apple accepts) and runs the
# daily purge (sign-in steps, expired sessions, idle accounts, the erasure ledger's retention). The site also does
# this from ordinary requests, but a deletion must reach Apple, and an idle account must go, with no visitors.
#
#   dolphin-maps/prod/housekeeping   the shared secret (HOUSEKEEPING_SECRET), generated here. The endpoint answers
#                                    404 without it. Readable by administration only; the copy in the Vercel
#                                    project's production environment is set by the owner (ejc3/aws does not
#                                    write that project's environment yet). Rotate with
#                                    `-replace=random_password.dolphin_maps_housekeeping`, then set the new value in
#                                    Vercel.
#   dolphin-maps-housekeeping        the EventBridge connection (it keeps the header in its own secret), the API
#                                    destination, the rule and an alarm on failed calls.
#
# The rule starts DISABLED. Bring-up, once:
#   1. Apply: the secret has a value.
#   2. As the owner, put it in Vercel (project dolphin-maps, Production, sensitive):
#        aws secretsmanager get-secret-value --region us-west-1 --secret-id dolphin-maps/prod/housekeeping \
#          --query SecretString --output text | vercel env add HOUSEKEEPING_SECRET production --sensitive
#      and redeploy production, after the accounts code is on main.
#   3. Set dolphin_maps_housekeeping_enabled = true in a commit, plan and apply.

variable "dolphin_maps_housekeeping_enabled" {
  description = "Call dolphin-maps' /api/housekeeping every 15 minutes. Turn on once HOUSEKEEPING_SECRET is in the Vercel production environment."
  type        = bool
  default     = false
}

locals {
  dolphin_maps_housekeeping_url = "https://dolphin-maps.vercel.app/api/housekeeping"
}

resource "random_password" "dolphin_maps_housekeeping" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "dolphin_maps_housekeeping" {
  name                    = "dolphin-maps/prod/housekeeping"
  description             = "dolphin-maps' HOUSEKEEPING_SECRET: the bearer token of the scheduled POST to /api/housekeeping. Generated by Terraform; dolphin-maps-housekeeping.tf. Administration only."
  recovery_window_in_days = 7
  tags                    = { Name = "dolphin-maps/prod/housekeeping", Project = "dolphin-maps" }
}

resource "aws_secretsmanager_secret_version" "dolphin_maps_housekeeping" {
  secret_id     = aws_secretsmanager_secret.dolphin_maps_housekeeping.id
  secret_string = random_password.dolphin_maps_housekeeping.result
}

resource "aws_cloudwatch_event_connection" "dolphin_maps_housekeeping" {
  name               = "dolphin-maps-housekeeping"
  description        = "The bearer token of dolphin-maps' /api/housekeeping."
  authorization_type = "API_KEY"
  auth_parameters {
    api_key {
      key   = "Authorization"
      value = "Bearer ${random_password.dolphin_maps_housekeeping.result}"
    }
  }
}

resource "aws_cloudwatch_event_api_destination" "dolphin_maps_housekeeping" {
  name                             = "dolphin-maps-housekeeping"
  description                      = "dolphin-maps' account housekeeping endpoint."
  invocation_endpoint              = local.dolphin_maps_housekeeping_url
  http_method                      = "POST"
  invocation_rate_limit_per_second = 1
  connection_arn                   = aws_cloudwatch_event_connection.dolphin_maps_housekeeping.arn
}

resource "aws_cloudwatch_event_rule" "dolphin_maps_housekeeping" {
  name                = "dolphin-maps-housekeeping"
  description         = "Every 15 minutes: dolphin-maps' Apple revocations and purge."
  schedule_expression = "rate(15 minutes)"
  state               = var.dolphin_maps_housekeeping_enabled ? "ENABLED" : "DISABLED"
  tags                = { Name = "dolphin-maps-housekeeping", Project = "dolphin-maps" }
}

resource "aws_iam_role" "dolphin_maps_housekeeping" {
  name = "dolphin-maps-housekeeping"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "events.amazonaws.com" }
      Action    = "sts:AssumeRole"
      Condition = { StringEquals = { "aws:SourceAccount" = data.aws_caller_identity.current.account_id } }
    }]
  })
  tags = { Name = "dolphin-maps-housekeeping", Project = "dolphin-maps" }
}

resource "aws_iam_role_policy" "dolphin_maps_housekeeping" {
  name = "invoke-dolphin-maps-housekeeping"
  role = aws_iam_role.dolphin_maps_housekeeping.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "events:InvokeApiDestination"
      Resource = aws_cloudwatch_event_api_destination.dolphin_maps_housekeeping.arn
    }]
  })
}

# A missed run is retried by the next one, 15 minutes later; no retries of its own.
resource "aws_cloudwatch_event_target" "dolphin_maps_housekeeping" {
  rule     = aws_cloudwatch_event_rule.dolphin_maps_housekeeping.name
  arn      = aws_cloudwatch_event_api_destination.dolphin_maps_housekeeping.arn
  role_arn = aws_iam_role.dolphin_maps_housekeeping.arn
  input    = "{}"
  retry_policy {
    maximum_retry_attempts       = 0
    maximum_event_age_in_seconds = 60
  }
}

# The endpoint answers 404 to a wrong secret and 500 when the revocations or the purge fail; either is a failed
# invocation. Four in a row (an hour) is a broken deploy, a missing secret or a down database, not one bad call.
resource "aws_cloudwatch_metric_alarm" "dolphin_maps_housekeeping_failed" {
  count               = var.dolphin_maps_housekeeping_enabled ? 1 : 0
  alarm_name          = "dolphin-maps-housekeeping-failed"
  alarm_description   = "dolphin-maps' /api/housekeeping failed for an hour: deleted accounts' Apple tokens are not being revoked and the purge is not running. Check HOUSEKEEPING_SECRET in Vercel production against dolphin-maps/prod/housekeeping, and the site's logs."
  namespace           = "AWS/Events"
  metric_name         = "FailedInvocations"
  dimensions          = { RuleName = aws_cloudwatch_event_rule.dolphin_maps_housekeeping.name }
  statistic           = "Sum"
  period              = 900
  evaluation_periods  = 4
  threshold           = 1
  comparison_operator = "GreaterThanOrEqualToThreshold"
  treat_missing_data  = "notBreaching"
  alarm_actions       = [aws_sns_topic.cost_alerts.arn]
}
