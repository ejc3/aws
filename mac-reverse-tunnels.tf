# `ssh mac` on fcvm-metal-arm: the ONE way to EJ's MacBook Pro from there. It goes through
# Cloudflare Access (macbook-ssh.tf: macbook-ssh.cc-games.dev, fcvm-arm's service token) to the
# Mac's own connector and ends at the Mac's desktop-session sshd (its 127.0.0.1:22222), where the
# external drive, Apple Events and the login keychain all work. No AWS inbound port, no reverse
# tunnel to this box. The existing ~/.ssh/to-mac private key stays on the persistent ARM root.
locals {
  # The MacBook's public host keys, read directly from EJ's MacBook Pro. ONE copy: fcvm-arm's `mac` below and ejc3's
  # container on the containerized nextjs box (nextjs-ct-user-data.tf) both pin these. The first (...IAX5Q08R6...) is the
  # desktop-session sshd's (~/.ssh/fcvm-macbook/ssh_host_ed25519_key on the Mac), where every route ends; the second
  # (...ID1DlX7...) is macOS Remote Login's, kept so a route pointed back at port 22 still verifies.
  mac_tunnel_host_keys = <<-MACHOSTKEYS
ejs-macbook-pro-via-fcvm ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAX5Q08R6QP8SbnpXPZTKTwGgrLz4DnGMZzRw2EDGaxn
ejs-macbook-pro-via-fcvm ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAID1DlX7dlpsRWSQuPOHoiDxtiyZd7/W4I1toKoLi7zfL
MACHOSTKEYS

  # cloudflared for Host mac's proxy command, pinned with claw-master's (claw-master-tunnel.tf). Kept out of
  # mac_reverse_tunnel_setup, which scripts/test-mac-tunnel-aliases.py runs as plain bash.
  macbook_cloudflared_install = <<-MACCFD
install -d -o ubuntu -g ubuntu /home/ubuntu/.local/bin
if ! echo "${local.cloudflared_sha256_linux_arm}  /home/ubuntu/.local/bin/cloudflared" | sha256sum -c - >/dev/null 2>&1; then
  if curl -fsSL "https://github.com/cloudflare/cloudflared/releases/download/${local.cloudflared_version}/cloudflared-linux-arm64" -o /tmp/cloudflared.new \
     && echo "${local.cloudflared_sha256_linux_arm}  /tmp/cloudflared.new" | sha256sum -c - >/dev/null; then
    install -o ubuntu -g ubuntu -m 755 /tmp/cloudflared.new /home/ubuntu/.local/bin/cloudflared
  else
    echo "WARNING: cloudflared ${local.cloudflared_version} did not download or match its sha256; ssh mac needs it" >&2
  fi
  rm -f /tmp/cloudflared.new
fi
MACCFD

  mac_reverse_tunnel_setup = <<-MACSETUP
install -d -m 700 -o ubuntu -g ubuntu /home/ubuntu/.ssh

cat > /home/ubuntu/.ssh/config.d-mac-tunnels <<'MACCONFIG'
# Generated by Terraform (mac-reverse-tunnels.tf).
# EJ's MacBook Pro, the one way in: Cloudflare Access (macbook-ssh.tf) with fcvm-arm's service
# token, then the Mac's desktop-session sshd (127.0.0.1:22222 on the Mac). README, "The MacBook".
Host mac
    HostName macbook-ssh.cc-games.dev
    User ejcampbell
    IdentityFile ~/.ssh/to-mac
    IdentitiesOnly yes
    ProxyCommand ~/.ssh/mac-access-proxy %h
    HostKeyAlias ejs-macbook-pro-via-fcvm
    UserKnownHostsFile ~/.ssh/known_hosts.mac-tunnels
    StrictHostKeyChecking yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
MACCONFIG

# ProxyCommand for Host mac. The Access service token reaches cloudflared through its
# environment, never its arguments, and is read for each connection (a rotation needs nothing here).
cat > /home/ubuntu/.ssh/mac-access-proxy <<'MACPROXY'
#!/bin/sh
set -eu
set +x
s=$(aws secretsmanager get-secret-value --region us-west-1 --secret-id macbook-ssh-access \
      --query SecretString --output text)
TUNNEL_SERVICE_TOKEN_ID=$(printf '%s' "$s" | jq -r .client_id)
TUNNEL_SERVICE_TOKEN_SECRET=$(printf '%s' "$s" | jq -r .client_secret)
export TUNNEL_SERVICE_TOKEN_ID TUNNEL_SERVICE_TOKEN_SECRET
PATH="$HOME/.local/bin:$PATH" exec cloudflared access ssh --hostname "$1"
MACPROXY
# Its name before the aliases were folded into `mac`.
rm -f /home/ubuntu/.ssh/macbook-access-proxy

# Public host identity read directly from EJ's MacBook Pro (local.mac_tunnel_host_keys).
cat > /home/ubuntu/.ssh/known_hosts.mac-tunnels <<'MACHOSTKEYS'
${local.mac_tunnel_host_keys}MACHOSTKEYS

# Include first so an old Host * cannot override a managed destination. Migrate only the
# standalone hand-written stanzas for the old names (mac, macbook, macbook-desktop), with the
# comment lines directly above each; preserve unrelated hosts, includes and their comments.
python3 - <<'MACMIGRATE'
from pathlib import Path
import hashlib
import os
import shlex
import tempfile

path = Path('/home/ubuntu/.ssh/config')
original = path.read_text() if path.exists() else ''
include = 'Include ~/.ssh/config.d-mac-tunnels'
retired = ('mac', 'macbook', 'macbook-desktop')
kept = []
pending = []
skip = False

def flush(lines, dropped):
    if not dropped:
        kept.extend(lines)

for line in original.splitlines(keepends=True):
    if line.strip() == include:
        continue
    fields = shlex.split(line, comments=True)
    if not fields:
        pending.append(line)
        continue
    if fields[0].lower() in ('host', 'match'):
        attached = len(pending)
        while attached and pending[attached - 1].lstrip().startswith('#'):
            attached -= 1
        flush(pending[:attached], skip)
        skip = (fields[0].lower() == 'host' and len(fields) == 2 and fields[1] in retired)
        flush(pending[attached:], skip)
    else:
        flush(pending, skip)
    pending = []
    flush([line], skip)
flush(pending, skip)

updated = include + '\n\n' + ''.join(kept).lstrip('\n')
if updated != original:
    backup = path.with_name('config.before-mac-tunnels')
    if backup.exists():
        backup = path.with_name('config.before-mac-tunnels.' + hashlib.sha256(original.encode()).hexdigest()[:12])
    if path.exists() and not backup.exists():
        backup.write_text(original)
        backup.chmod(0o600)
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as f:
        f.write(updated)
        temporary = f.name
    os.replace(temporary, path)
MACMIGRATE

chown ubuntu:ubuntu /home/ubuntu/.ssh/config /home/ubuntu/.ssh/config.d-mac-tunnels /home/ubuntu/.ssh/known_hosts.mac-tunnels
chmod 600 /home/ubuntu/.ssh/config /home/ubuntu/.ssh/config.d-mac-tunnels /home/ubuntu/.ssh/known_hosts.mac-tunnels
chown ubuntu:ubuntu /home/ubuntu/.ssh/mac-access-proxy
chmod 700 /home/ubuntu/.ssh/mac-access-proxy
MACSETUP
}

output "mac_reverse_tunnel_usage" {
  description = "SSH to EJ's MacBook Pro from fcvm-arm"
  value       = "from fcvm-arm as ubuntu: ssh mac (Cloudflare Access, macbook-ssh.cc-games.dev, to the Mac's desktop-session sshd)"
}
