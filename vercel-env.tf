# vercel-env.tf
#
# Terraform writes the Vercel environments of the sites whose variables were set by hand (imagine, remote-claw,
# nest-step) from AWS, so AWS is the one source for every site on both clouds (the standing rule in
# AGENTS.md, "Sites also deploying to Cloudflare Workers"). This first part is the Vercel API token for the owner's
# personal team (imagine, remote-claw), which no Terraform provider here could reach: an API token scoped to that one
# team, minted by API with vercel-admin-token (github-admin-tokens.tf), never anyone's CLI login.
resource "aws_secretsmanager_secret" "vercel_api_token_ejc3" {
  name                    = "vercel-api-token-ejc3"
  description             = "Vercel API token for the owner's personal team (imagine, remote-claw): Terraform writes those projects' environments with it. Minted by API; see vercel-env.tf."
  recovery_window_in_days = 30
  tags                    = { Name = "vercel-api-token-ejc3", Project = "vercel-env" }

  lifecycle {
    prevent_destroy = true
  }
}

# Administration only, whatever an identity policy elsewhere says: a dev box holding this could change or take down the sites.
resource "aws_secretsmanager_secret_policy" "vercel_api_token_ejc3" {
  secret_arn = aws_secretsmanager_secret.vercel_api_token_ejc3.arn
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "OnlyAdministrationCanRead"
      Effect    = "Deny"
      Principal = "*"
      Action    = "secretsmanager:GetSecretValue"
      Resource  = aws_secretsmanager_secret.vercel_api_token_ejc3.arn
      Condition = { ArnNotLike = { "aws:PrincipalArn" = local.games_mp_admin_principals } }
    }]
  })
}

# The colton-games team's own Terraform token (vercel-cc-games.tf) cannot see nest-step's project ("Project not found"),
# so nest-step gets a token for that team minted by API with vercel-admin-token, as for the personal team above.
resource "aws_secretsmanager_secret" "vercel_api_token_coltons" {
  name                    = "vercel-api-token-coltons"
  description             = "Vercel API token for Colton's team, minted by API for vercel-env.tf (nest-step). Administration only; see vercel-env.tf."
  recovery_window_in_days = 30
  tags                    = { Name = "vercel-api-token-coltons", Project = "vercel-env" }

  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_secretsmanager_secret_policy" "vercel_api_token_coltons" {
  secret_arn = aws_secretsmanager_secret.vercel_api_token_coltons.arn
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "OnlyAdministrationCanRead"
      Effect    = "Deny"
      Principal = "*"
      Action    = "secretsmanager:GetSecretValue"
      Resource  = aws_secretsmanager_secret.vercel_api_token_coltons.arn
      Condition = { ArnNotLike = { "aws:PrincipalArn" = local.games_mp_admin_principals } }
    }]
  })
}

# ---------------------------------------------------------------------------------------------------------------------
# The environments. One resource per variable Vercel holds today (vercel-env-vars.tf, generated by
# scripts/vercel-env-inventory.py from the Vercel API: id, name, targets, sensitivity), IMPORTED by its Vercel id, so
# nothing is deleted or recreated: Terraform takes over each variable exactly as it is. Its value comes from the
# container `vercel-env/<site>/<target>` (vercel-env-secrets.tf), which is now the SOURCE, no longer a record captured
# after the fact: change a value there and apply, never in the Vercel dashboard (Vercel refuses a second variable with
# the same key on a target, and the next apply would write the container's value back). A variable on several targets
# takes its value from the first and a precondition refuses the plan if the targets' containers disagree.
#
# Not here: colton-games, whose Terraform-written variables live in their own file. Nor dolphin-labs: it left Vercel
# (gamesworthwatching-zone.tf) and its team is being deleted, so its variables are forgotten (dolphin-vercel-retired.tf);
# its containers stay, as the source of the dolphin-labs-prod Worker's secrets (vercel-env-secrets.tf).
#
# Adding a variable: put its value in the target's container, add it in Vercel or let Terraform create it (re-run the
# inventory after a dashboard change), plan. Values pass through Terraform state, as for the other projects; state is
# readable by administration only (Terraform is pinned to 1.10, before write-only arguments).
locals {
  # Kept equal to PROJECTS in scripts/vercel-env-inventory.py (scripts/test-vercel-env.py checks).
  vercel_env_projects = {
    "imagine"     = { project_id = "prj_MNp1CoEL7jqd3ufUb0lL98vTMBTV", team_id = "team_fYexi4KRmIrq9wtYsiXs9e9H" }
    "nest-step"   = { project_id = "prj_UEBlk5ovC3cPF0oaXwgZyGuRQtId", team_id = "team_luQ5Id7cevXQ5kBbxzV7Jk2B" }
    "remote-claw" = { project_id = "prj_qUeYYc7P87JmsQUipJG0m0kqmYbM", team_id = "team_fYexi4KRmIrq9wtYsiXs9e9H" }
  }

  # Which provider reaches each team: the Colton's-team token minted for this file (vercel_api_token_coltons: the
  # colton-games team's own token cannot see nest-step) and the personal-team token.
  vercel_env_by_team = {
    coltons = { for id, v in local.vercel_env_vars : id => v if local.vercel_env_projects[split("/", id)[0]].team_id == "team_luQ5Id7cevXQ5kBbxzV7Jk2B" }
    ejc3    = { for id, v in local.vercel_env_vars : id => v if local.vercel_env_projects[split("/", id)[0]].team_id == "team_fYexi4KRmIrq9wtYsiXs9e9H" }
  }

  # The containers the variables need: "site/target".
  vercel_env_needed = toset(flatten([for id, v in local.vercel_env_vars : [for t in v.target : "${split("/", id)[0]}/${t}"]]))
}

data "aws_secretsmanager_secret_version" "vercel_env" {
  for_each  = local.vercel_env_needed
  secret_id = aws_secretsmanager_secret.vercel_env[each.key].id
}

locals {
  # Sensitive from here on. A missing key becomes null and a precondition names it; Terraform never quotes a value.
  vercel_env_record = { for name, version in data.aws_secretsmanager_secret_version.vercel_env : name => try(jsondecode(version.secret_string), {}) }
  vercel_env_value = {
    for id, v in local.vercel_env_vars : id => try(tostring(local.vercel_env_record["${split("/", id)[0]}/${v.target[0]}"][v.key]), null)
  }
  # Every target's value for a multi-target variable must be the same one.
  vercel_env_agrees = {
    for id, v in local.vercel_env_vars : id => length(distinct([
      for t in v.target : try(tostring(local.vercel_env_record["${split("/", id)[0]}/${t}"][v.key]), "<missing>")
    ])) == 1
  }
}

ephemeral "aws_secretsmanager_secret_version" "vercel_api_token_ejc3" {
  secret_id = aws_secretsmanager_secret.vercel_api_token_ejc3.id
}

ephemeral "aws_secretsmanager_secret_version" "vercel_api_token_coltons" {
  secret_id = aws_secretsmanager_secret.vercel_api_token_coltons.id
}

provider "vercel" {
  alias     = "coltons"
  api_token = trimspace(ephemeral.aws_secretsmanager_secret_version.vercel_api_token_coltons.secret_string)
}

provider "vercel" {
  alias     = "ejc3"
  api_token = trimspace(ephemeral.aws_secretsmanager_secret_version.vercel_api_token_ejc3.secret_string)
}

resource "vercel_project_environment_variable" "vercel_env_coltons" {
  provider   = vercel.coltons
  for_each   = local.vercel_env_by_team.coltons
  team_id    = local.vercel_env_projects[split("/", each.key)[0]].team_id
  project_id = local.vercel_env_projects[split("/", each.key)[0]].project_id
  key        = each.value.key
  value      = local.vercel_env_value[each.key]
  target     = each.value.target
  sensitive  = each.value.sensitive
  comment    = "managed by ejc3/aws vercel-env.tf from vercel-env/${split("/", each.key)[0]}"

  lifecycle {
    precondition {
      condition     = local.vercel_env_value[each.key] != null
      error_message = "vercel-env/${split("/", each.key)[0]}/${each.value.target[0]} has no ${each.value.key}."
    }
    precondition {
      condition     = local.vercel_env_agrees[each.key]
      error_message = "${each.value.key} differs between the containers of its targets (${join(", ", each.value.target)}) in vercel-env/${split("/", each.key)[0]}."
    }
  }
}

resource "vercel_project_environment_variable" "vercel_env_ejc3" {
  provider   = vercel.ejc3
  for_each   = local.vercel_env_by_team.ejc3
  team_id    = local.vercel_env_projects[split("/", each.key)[0]].team_id
  project_id = local.vercel_env_projects[split("/", each.key)[0]].project_id
  key        = each.value.key
  value      = local.vercel_env_value[each.key]
  target     = each.value.target
  sensitive  = each.value.sensitive
  comment    = "managed by ejc3/aws vercel-env.tf from vercel-env/${split("/", each.key)[0]}"

  lifecycle {
    precondition {
      condition     = local.vercel_env_value[each.key] != null
      error_message = "vercel-env/${split("/", each.key)[0]}/${each.value.target[0]} has no ${each.value.key}."
    }
    precondition {
      condition     = local.vercel_env_agrees[each.key]
      error_message = "${each.value.key} differs between the containers of its targets (${join(", ", each.value.target)}) in vercel-env/${split("/", each.key)[0]}."
    }
  }
}

# Take over the variables Vercel already holds, by id, instead of creating duplicates (which Vercel refuses).
import {
  for_each = local.vercel_env_by_team.coltons
  to       = vercel_project_environment_variable.vercel_env_coltons[each.key]
  id       = "${local.vercel_env_projects[split("/", each.key)[0]].team_id}/${local.vercel_env_projects[split("/", each.key)[0]].project_id}/${split("/", each.key)[1]}"
}

import {
  for_each = local.vercel_env_by_team.ejc3
  to       = vercel_project_environment_variable.vercel_env_ejc3[each.key]
  id       = "${local.vercel_env_projects[split("/", each.key)[0]].team_id}/${local.vercel_env_projects[split("/", each.key)[0]].project_id}/${split("/", each.key)[1]}"
}

# Names only: what Terraform writes, per site.
output "vercel_env_written" {
  description = "The Vercel variables vercel-env.tf manages, per site (names only)."
  value       = { for site in keys(local.vercel_env_projects) : site => sort(distinct([for id, v in local.vercel_env_vars : v.key if split("/", id)[0] == site])) }
}
