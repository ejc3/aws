# `ssh mac`: the ONE way to EJ's MacBook Pro, the same on every box that has it. Each client goes through
# Cloudflare Access (macbook-ssh.tf: macbook-ssh.cc-games.dev) with ITS OWN service token, to the Mac's
# connector, and ends at the Mac's desktop-session sshd (its 127.0.0.1:22222), where the external drive,
# Apple Events and the login keychain all work. No inbound port anywhere, and no reverse tunnel.
#
#   fcvm-arm, ubuntu    token macbook-ssh-access               (dev-user-data.tf)
#   nextjs-dev, ejc3    token macbook-ssh-access-nextjs-ejc3   (nextjs-user-data.tf; ejc3 only)
#
# The private key (~/.ssh/to-mac) is never installed by anything: it stays where the owner put it.
locals {
  # The MacBook's desktop-session sshd host key (~/.ssh/fcvm-macbook/ssh_host_ed25519_key.pub on the Mac), read
  # on the Mac itself. ONE copy: every `Host mac` here and ejc3's container on the containerized nextjs box
  # (nextjs-ct-user-data.tf) pin it. macOS Remote Login's key is no longer pinned: no route ends there.
  mac_tunnel_host_keys = <<-MACHOSTKEYS
ejs-macbook-pro-via-fcvm ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAX5Q08R6QP8SbnpXPZTKTwGgrLz4DnGMZzRw2EDGaxn
MACHOSTKEYS

  # cloudflared for the proxy command, pinned with claw-master's (claw-master-tunnel.tf), into the account's
  # ~/.local/bin. Expects MAC_USER (see mac_ssh_client_setup). Kept out of mac_ssh_client_setup, which
  # scripts/test-mac-ssh-client.py runs as plain bash.
  mac_cloudflared_install = <<-MACCFD
install -d -o "$MAC_USER" -g "$MAC_USER" "/home/$MAC_USER/.local" "/home/$MAC_USER/.local/bin"
if ! echo "${local.cloudflared_sha256_linux_arm}  /home/$MAC_USER/.local/bin/cloudflared" | sha256sum -c - >/dev/null 2>&1; then
  if curl -fsSL "https://github.com/cloudflare/cloudflared/releases/download/${local.cloudflared_version}/cloudflared-linux-arm64" -o /tmp/cloudflared-mac.new \
     && echo "${local.cloudflared_sha256_linux_arm}  /tmp/cloudflared-mac.new" | sha256sum -c - >/dev/null; then
    install -o "$MAC_USER" -g "$MAC_USER" -m 755 /tmp/cloudflared-mac.new "/home/$MAC_USER/.local/bin/cloudflared"
  else
    echo "WARNING: cloudflared ${local.cloudflared_version} did not download or match its sha256; ssh mac needs it" >&2
  fi
  rm -f /tmp/cloudflared-mac.new
fi
MACCFD

  # `Host mac` for one account. Run as root with MAC_USER (the account) and MAC_SECRET (the Secrets Manager
  # secret holding that account's Access service token) set; MAC_HOME defaults to /home/$MAC_USER.
  mac_ssh_client_setup = <<-MACSETUP
MAC_HOME="$${MAC_HOME:-/home/$MAC_USER}"
install -d -m 700 -o "$MAC_USER" -g "$MAC_USER" "$MAC_HOME/.ssh"

cat > "$MAC_HOME/.ssh/config.d-mac" <<'MACCONFIG'
# Generated by Terraform (mac-ssh-client.tf). EJ's MacBook Pro, the one way in: Cloudflare Access
# (macbook-ssh.tf) with this account's service token, then the Mac's desktop-session sshd.
Host mac
    HostName macbook-ssh.cc-games.dev
    User ejcampbell
    IdentityFile ~/.ssh/to-mac
    IdentitiesOnly yes
    ProxyCommand ~/.ssh/mac-access-proxy %h
    HostKeyAlias ejs-macbook-pro-via-fcvm
    UserKnownHostsFile ~/.ssh/known_hosts.mac
    StrictHostKeyChecking yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
MACCONFIG

# ProxyCommand for Host mac. The Access service token reaches cloudflared through its environment,
# never its arguments, and is read for each connection (a rotation needs nothing here).
cat > "$MAC_HOME/.ssh/mac-access-proxy.new" <<'MACPROXY'
#!/bin/sh
set -eu
set +x
s=$(aws secretsmanager get-secret-value --region us-west-1 --secret-id @MAC_SECRET@ \
      --query SecretString --output text)
TUNNEL_SERVICE_TOKEN_ID=$(printf '%s' "$s" | jq -r .client_id)
TUNNEL_SERVICE_TOKEN_SECRET=$(printf '%s' "$s" | jq -r .client_secret)
export TUNNEL_SERVICE_TOKEN_ID TUNNEL_SERVICE_TOKEN_SECRET
PATH="$HOME/.local/bin:$PATH" exec cloudflared access ssh --hostname "$1"
MACPROXY
sed -i "s|@MAC_SECRET@|$MAC_SECRET|" "$MAC_HOME/.ssh/mac-access-proxy.new"
mv -f "$MAC_HOME/.ssh/mac-access-proxy.new" "$MAC_HOME/.ssh/mac-access-proxy"

cat > "$MAC_HOME/.ssh/known_hosts.mac" <<'MACHOSTKEYS'
${local.mac_tunnel_host_keys}MACHOSTKEYS

# What earlier routes left behind: the reverse tunnels' and the first Cloudflare aliases' files.
rm -f "$MAC_HOME/.ssh/config.d-mac-tunnels" "$MAC_HOME/.ssh/known_hosts.mac-tunnels" \
      "$MAC_HOME/.ssh/macbook-access-proxy" "$MAC_HOME/.ssh/config.d-macbook"

# Include first so an old Host * cannot override it. Retire the old Includes and any standalone
# stanza for an old name (mac, macbook, macbook-desktop) with the comment lines directly above it;
# keep unrelated hosts, includes and their comments. The original is backed up once per content.
MAC_HOME="$MAC_HOME" python3 - <<'MACMIGRATE'
from pathlib import Path
import hashlib
import os
import shlex
import tempfile

path = Path(os.environ['MAC_HOME']) / '.ssh' / 'config'
original = path.read_text() if path.exists() else ''
include = 'Include ~/.ssh/config.d-mac'
old_includes = {include, 'Include ~/.ssh/config.d-mac-tunnels', 'Include config.d-mac',
                'Include config.d-macbook', 'Include ~/.ssh/config.d-macbook'}
retired = ('mac', 'macbook', 'macbook-desktop')
kept = []
pending = []
skip = False

def flush(lines, dropped):
    if not dropped:
        kept.extend(lines)

for line in original.splitlines(keepends=True):
    if line.strip() in old_includes:
        continue
    fields = shlex.split(line, comments=True)
    if not fields:
        pending.append(line)
        continue
    if fields[0].lower() in ('host', 'match'):
        attached = len(pending)
        while attached and pending[attached - 1].lstrip().startswith('#'):
            attached -= 1
        flush(pending[:attached], skip)
        skip = (fields[0].lower() == 'host' and len(fields) == 2 and fields[1] in retired)
        flush(pending[attached:], skip)
    else:
        flush(pending, skip)
    pending = []
    flush([line], skip)
flush(pending, skip)

updated = include + '\n\n' + ''.join(kept).lstrip('\n')
if updated != original:
    if path.exists():
        backup = path.with_name('config.before-mac.' + hashlib.sha256(original.encode()).hexdigest()[:12])
        if not backup.exists():
            backup.write_text(original)
            backup.chmod(0o600)
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as f:
        f.write(updated)
        temporary = f.name
    os.replace(temporary, path)
MACMIGRATE

chown "$MAC_USER:$MAC_USER" "$MAC_HOME/.ssh/config" "$MAC_HOME/.ssh/config.d-mac" "$MAC_HOME/.ssh/known_hosts.mac" "$MAC_HOME/.ssh/mac-access-proxy"
chmod 600 "$MAC_HOME/.ssh/config" "$MAC_HOME/.ssh/config.d-mac" "$MAC_HOME/.ssh/known_hosts.mac"
chmod 700 "$MAC_HOME/.ssh/mac-access-proxy"
MACSETUP
}

output "mac_ssh_usage" {
  description = "SSH to EJ's MacBook Pro"
  value       = "ssh mac, as ubuntu on fcvm-arm or ejc3 on nextjs-dev (Cloudflare Access, macbook-ssh.cc-games.dev, to the Mac's desktop-session sshd)"
}
