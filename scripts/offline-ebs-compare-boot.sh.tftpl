#!/bin/bash
set -Eeuo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
LAB=/run/evidence-lab
mkdir -p "$LAB/pre" "$LAB/post"
serial() {
  local console
  for console in /dev/ttyS0 /dev/ttyAMA0 /dev/console; do
    if [[ -c "$console" ]]; then
      timeout 3s sh -c 'printf "%s\n" "$1" > "$2"' sh "$1" "$console" || :
    fi
  done
}
stage=init
cleanup() {
  local result=$?
  trap - EXIT
  umount "$LAB/post" >/dev/null 2>&1 || :
  umount "$LAB/pre" >/dev/null 2>&1 || :
  if (( result != 0 )); then
    serial "EVIDENCE_ERROR stage=$stage"
  fi
  shutdown -h +10 >/dev/null 2>&1 || :
  exit "$result"
}
trap cleanup EXIT
exec >"$LAB/private.log" 2>&1
serial 'EVIDENCE_START'
stage=lock_network
for nic in /sys/class/net/*; do
  [[ "$nic" == /sys/class/net/lo ]] || ip link set dev "$${nic##*/}" down
done
cat > "$LAB/analysis.py" <<'PYTHON'
${analysis}
PYTHON
printf '%s' '${config_base64}' | base64 -d > "$LAB/config.json"
disk_for() {
  local vol="$1" dev found=''
  for _ in $(seq 1 180); do
    for dev in /sys/class/block/nvme*n*; do
      [[ -r "$dev/device/serial" ]] || continue
      if [[ $(tr -d '[:space:]' < "$dev/device/serial") == "$${vol//-/}" ]]; then
        if [[ -n "$found" ]]; then return 1; fi
        found="/dev/$${dev##*/}"
      fi
    done
    if [[ -b "$found" ]]; then printf '%s\n' "$found"; return; fi
    found=''
    sleep 5
  done
  return 1
}
mount_evidence() {
  local disk="$1" target="$2" part type
  [[ $(blockdev --getsize64 "$disk") -eq ${volume_bytes} ]]
  blockdev --setro "$disk"
  # Select only the unique large root partition; fail closed if layout differs.
  mapfile -t roots < <(lsblk -blpn -o NAME,TYPE,SIZE "$disk" |
    awk -v minimum=$(( ${volume_bytes} * 8 / 10 )) '$2=="part" && $3>=minimum {print $1}')
  [[ $${#roots[@]} -eq 1 ]]
  part="$${roots[0]}"
  blockdev --setro "$part"
  [[ $(blockdev --getro "$disk") == 1 && $(blockdev --getro "$part") == 1 ]]
  type=$(blkid -p -s TYPE -o value "$part")
  [[ "$type" == ext4 ]]
  mount -t ext4 -o ro,noload,nodev,nosuid,noexec "$part" "$target"
  findmnt --noheadings --output OPTIONS --mountpoint "$target" | awk -F, '
    { for(i=1;i<=NF;i++) found[$i]=1 }
    END {exit !(found["ro"] && found["nodev"] && found["nosuid"] && found["noexec"] && (found["norecovery"] || found["noload"]))}'
}
stage=discover_volumes
PRE=$(disk_for '${pre_volume}')
POST=$(disk_for '${post_volume}')
[[ "$PRE" != "$POST" ]]
stage=read_only_mount
mount_evidence "$PRE" "$LAB/pre"
mount_evidence "$POST" "$LAB/post"
stage=compare
timeout 900 /usr/bin/python3 -I "$LAB/analysis.py" "$LAB/pre" "$LAB/post" "$LAB/config.json" > "$LAB/result.json"
[[ $(wc -c < "$LAB/result.json") -lt 3000 ]]
serial "EVIDENCE_RESULT $(cat "$LAB/result.json")"
stage=done
