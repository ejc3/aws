#!/bin/bash
# claude-rc-ensure <user> -- repair a DEAD Remote Control binding, and nothing else.
#
# THIS SCRIPT TYPES INTO A LIVE SESSION SOMEONE IS USING. Read the next paragraph before
# changing it.
#
# The first version triggered on the ABSENCE of a success string ("/rc active") in the
# pane. A Claude Code update changed that footer to render as just "/rc", so success became
# undetectable and the script "repaired" a perfectly healthy connection every time it ran
# -- 21 times in six hours per user. Each repair DISCONNECTED a working session, and the
# blind "1" keystroke meant for the enable menu landed in the prompt instead and was SENT
# AS A MESSAGE, so the kids' conversations filled with "1" / "Standing by." and burned
# tokens toward the usage limit. The repair's own side effect ("Remote Control
# disconnected.") then looked like the fault it was meant to fix, so it fed itself.
#
# Three rules keep that from recurring:
#   1. Trigger on an EXPLICIT failure string, never on the absence of a success string.
#      If upstream changes its wording again this does nothing, which is the safe way to
#      be wrong.
#   2. Never send a menu selection without first SEEING that menu on screen. Escape out
#      instead -- a stray keystroke in this TUI is a message, not a no-op.
#   3. Rate limit. A repair loop that can run every ten minutes must not be able to touch
#      the same session more than once an hour.
set -uo pipefail
WHO="${1:?usage: claude-rc-ensure <user>}"
H="/home/$WHO"
tm() { sudo -u "$WHO" -H env HOME="$H" tmux "$@" 2>/dev/null; }
# Native Claude Code uses the version basename as its Linux process name. The
# claw-master wrapper does not prove that Claude itself started. Keep recognizing
# older "claude" processes, and check the executable of version-named candidates
# from this user's process list against the native install path.
claude_pids() {
  local pid comm exe version
  ps -u "$WHO" -o pid=,comm= 2>/dev/null | while read -r pid comm; do
    case "$comm" in
      claude) printf '%s\n' "$pid" ;;
      [0-9]*)
        exe=$(readlink -- "/proc/$pid/exe") || continue
        exe=${exe%" (deleted)"}
        version=${exe##*/}
        if [[ "$exe" == "$H/.local/share/claude/versions/$version" &&
              "$version" =~ ^[0-9]+[.][0-9]+[.][0-9]+([+-][0-9A-Za-z.+-]+)?$ ]]; then
          printf '%s\n' "$pid"
        fi
        ;;
    esac
  done
}
pids=$(claude_pids)
[ -n "$pids" ] || { echo "claude-rc-ensure: $WHO has no claude"; exit 0; }

# A keyed t-claude window must still have a Claude process of this user below
# its pane. A shell that merely prints an error must never receive repair input.
pane_claude_pid() {
  local pid ancestor
  for pid in $pids; do
    ancestor="$pid"
    while [ -n "$ancestor" ] && [ "$ancestor" -gt 1 ]; do
      if [ "$ancestor" = "$1" ]; then
        printf '%s\n' "$pid"
        return 0
      fi
      ancestor=$(ps -o ppid= -p "$ancestor" 2>/dev/null | tr -d ' ')
    done
  done
  return 1
}

pane_session() {
  local pids panepid pid started
  pids=$(claude_pids)
  panepid=$(tm display-message -p -t "$1" '#{pane_pid}') || return 1
  pid=$(pane_claude_pid "$panepid") || return 1
  started=$(ps -o lstart= -p "$pid" 2>/dev/null) || return 1
  [ -n "$started" ] || return 1
  printf '%s %s\n' "$pid" "$started"
}
# Inspect every managed window, once even when grouped sessions share it. Use
# the specific pane ID throughout: a window ID could follow a focus change.
panes=$(tm list-windows -a -F '#{pane_id} #{pane_pid} #{@tclaude_path}' | sort -u |
  while read -r paneid panepid keyed; do
    [ -n "$keyed" ] && pane_claude_pid "$panepid" >/dev/null && echo "$paneid"
  done)
[ -n "$panes" ] || { echo "claude-rc-ensure: $WHO has no claude window"; exit 0; }

STATEDIR=/var/lib/claude-rc-ensure
mkdir -p "$STATEDIR"

# Require a known empty Claude composer after the expected RC state. Unknown screens are
# safe to leave alone, as are drafts, background work, and a newer RC success.
idle_rc_prompt() {
  local screen="$1" expected="$2" line rc=unknown prompt=none input='^[[:space:]]*[❯›](.*)$'
  case "${screen,,}" in
    *"session creation failed"*|*"esc to interrupt"*|*"escape to interrupt"*|*"esc to cancel"*|*"esc to stop"*) return 1 ;;
  esac
  while IFS= read -r line; do
    case "$line" in
      *"Couldn't reconnect to your Remote Control session"*) rc=stale; prompt=none; continue ;;
      *"Remote Control disconnected."*) rc=disconnected; prompt=none; continue ;;
      *"Remote Control active"*|*"Remote Control connected"*|*"Remote Control enabled"*) rc=active ;;
      *"Remote Control is active"*|*"Remote Control is connected"*|*"Remote Control is enabled"*) rc=active ;;
      *"API Error:"*|*"Login reached its time limit"*|*"Please run /login"*) rc=unknown ;;
    esac
    if [[ "$line" =~ $input ]]; then
      if [[ "${BASH_REMATCH[1]}" =~ ^[[:space:]]*$ ]]; then
        prompt=empty
      else
        prompt=draft
      fi
    elif [[ "$prompt" == empty ]]; then
      if [[ "$line" =~ ^[[:space:]─━-]+$ && "$line" == *"────"* ]]; then
        prompt=confirmed
      elif [[ ! "$line" =~ ^[[:space:]]*$ ]]; then
        prompt=draft
      fi
    elif [[ "$prompt" == confirmed && "$line" =~ (^|[[:space:]])/rc([[:space:]]|$) ]]; then
      # /rc in the current status footer means the binding is back.
      rc=active
    fi
  done <<< "$screen"
  [ "$rc" = "$expected" ] && [ "$prompt" = confirmed ]
}

repair_pane() {
  local target="$1" label key STAMP now last P session current menu
  label=$(tm display-message -p -t "$target" '#{session_name}:#{window_name}')
  # Rate-limit key: the folder t-claude stamped on the window (stable across tmux restarts);
  # the window name, then its id, when it has none.
  key=$(tm display-message -p -t "$target" '#{@tclaude_path}')
  [ -n "$key" ] || key="$label"
  [ -n "$key" ] || key="$target"
  STAMP="$STATEDIR/$WHO-$(printf '%s' "$key" | cksum | awk '{print $1}')"

  # Only the CURRENT screen. Reading the whole scrollback means text left by an earlier
  # repair re-triggers the repair, forever.
  pane() { tm capture-pane -p -t "$target"; }
  P="$(pane)"

  # The one fault this fixes: a stale binding on a resumed conversation, whose reconnect
  # cannot succeed no matter how many times /remote-control retries it. Note this is NOT the
  # same as the bare "Remote Control disconnected." line, which is also what a deliberate
  # disconnect prints -- matching that would make the script chase its own tail.
  case "$P" in
    *"Couldn't reconnect to your Remote Control session"*) ;;
    *) echo "claude-rc-ensure: $WHO $label nothing to repair"; return 0 ;;
  esac

  # An upstream 503 is not ours to fix; it recovers on its own and restarting costs the session.
  case "$P" in
    *"Session creation failed"*) echo "claude-rc-ensure: $WHO $label upstream 503, leaving alone"; return 0 ;;
  esac

  now=$(date +%s)
  last=$(cat "$STAMP" 2>/dev/null || echo 0)
  if [ $((now - last)) -lt 3600 ]; then
    echo "claude-rc-ensure: $WHO $label repaired within the last hour, backing off"
    return 0
  fi
  # Recheck the same pane and its process just before typing. The failure may have cleared,
  # or the person may have started typing while we were inspecting the pane.
  if ! session=$(pane_session "$target") || ! idle_rc_prompt "$(pane)" stale; then
    echo "claude-rc-ensure: $WHO $label has no idle stale prompt; leaving alone"
    return 0
  fi
  echo "$now" > "$STAMP"

  echo "claude-rc-ensure: $WHO $label reconnect is dead -- dropping the stale binding"
  tm send-keys -t "$target" '/remote-control' Enter; sleep 8
  menu=$(pane)
  case "$menu" in
    *"Disconnect this session"*)
      tm send-keys -t "$target" Up; tm send-keys -t "$target" Up; tm send-keys -t "$target" Enter; sleep 6
      ;;
    *)
      echo "claude-rc-ensure: $WHO $label disconnect menu never appeared; leaving the session alone" >&2
      tm send-keys -t "$target" Escape
      return 0
      ;;
  esac

  # The menu action took time. Someone could have opened a draft, started
  # work, or let Claude recover. Require a newly visible disconnect and an
  # empty composer on the same Claude process before entering the command.
  current=$(pane_session "$target")
  P=$(pane)
  if [ "$current" != "$session" ] ||
     [ "$(grep -cF 'Remote Control disconnected.' <<< "$P" || true)" -le "$(grep -cF 'Remote Control disconnected.' <<< "$menu" || true)" ] ||
     ! idle_rc_prompt "$P" disconnected; then
    echo "claude-rc-ensure: $WHO $label did not return to the idle disconnected prompt; leaving alone"
    return 0
  fi
  tm send-keys -t "$target" '/remote-control' Enter; sleep 8
  case "$(pane)" in
    *"Enable Remote Control"*)
      tm send-keys -t "$target" '1'; sleep 1; tm send-keys -t "$target" Enter; sleep 8
      echo "claude-rc-ensure: $WHO $label re-enabled"
      ;;
    *)
      echo "claude-rc-ensure: $WHO $label enable menu never appeared; leaving the session alone" >&2
      tm send-keys -t "$target" Escape
      return 0
      ;;
  esac
}

for p in $panes; do repair_pane "$p"; done
exit 0
