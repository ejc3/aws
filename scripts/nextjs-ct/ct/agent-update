#!/bin/bash
# Update Claude Code, Codex and Vercel, then restart the agent services.
set -uo pipefail
export DEBIAN_FRONTEND=noninteractive
echo "=== agent-update $(date -u '+%F %T UTC') ==="

# Claude Code: `claude update` for every account, every night. Claude's own background updater is not enough: every pool
# session runs under `claw-master connect`, which sets DISABLE_AUTOUPDATER=1 for the Claude it launches, so on 2026-10-26
# this job reported "2.1.294 -> 2.1.294" in every container while 2.1.311 was out. An account with no native copy gets
# the installer instead, which also repairs one that went missing. Running sessions keep their binary; the next start of
# each (t-claude, the restarts below) runs the new one.
USERS_FILE=${AGENT_UPDATE_USERS:-/etc/nextjs-ct/user}
HOME_ROOT=${AGENT_UPDATE_HOMES:-/home}
for u in $(cat "$USERS_FILE"); do
  id -u "$u" >/dev/null 2>&1 || continue
  # shellcheck disable=SC2016 # $HOME is the account's, expanded by its own shell
  BEFORE=$(sudo -u "$u" -H bash -c '"$HOME/.local/bin/claude" --version 2>/dev/null | head -1')
  if [ -n "$BEFORE" ]; then
    # shellcheck disable=SC2016
    sudo -u "$u" -H env -u DISABLE_AUTOUPDATER bash -c 'cd "$HOME" && "$HOME/.local/bin/claude" update < /dev/null' >/dev/null 2>&1 \
      || echo "WARNING: claude update failed for $u"
  else
    sudo -u "$u" -H bash -c 'curl -fsSL https://claude.ai/install.sh | bash' >/dev/null 2>&1 || echo "WARNING: claude install failed for $u"
  fi
  # shellcheck disable=SC2016
  AFTER=$(sudo -u "$u" -H bash -c '"$HOME/.local/bin/claude" --version 2>/dev/null | head -1')
  echo "claude[$u]: ${BEFORE:-none} -> ${AFTER:-none}"
done
npm install -g vercel >/dev/null 2>&1 || echo "WARNING: vercel update failed"


for u in $(cat "$USERS_FILE"); do
  id "$u" >/dev/null 2>&1 || continue
  # Codex ships its own installer and self-updates the standalone bundle; re-running it is
  # the supported refresh. Must run AS the user from a directory they can read -- from
  # elsewhere it dies in `find` after creating releases/ but before current/.
  if [ -s "$HOME_ROOT/$u/.codex/auth.json" ]; then
    B=$(sudo -u "$u" -H $HOME_ROOT/$u/.local/bin/codex --version 2>/dev/null | head -1)
    sudo -u "$u" -H sh -c "cd $HOME_ROOT/$u && curl -fsSL https://chatgpt.com/codex/install.sh | sh" >/dev/null 2>&1 \
      || echo "WARNING: codex update failed for $u"
    echo "codex[$u]: ${B:-none} -> $(sudo -u "$u" -H $HOME_ROOT/$u/.local/bin/codex --version 2>/dev/null | head -1)"
  fi
  # Refresh the project list too, so a repo added during the day shows up.
  /usr/local/bin/kid-agents-refresh "$u" 2>&1 | sed "s/^/agents-md[$u]: /"
done

# A restart kills everything in the unit's cgroup (KillMode=control-group): the agent, its
# tmux server and every background job it started -- on 2026-09-20 that wiped a multi-hour
# build with nine running workflows. So do not restart a service whose user has a session
# that wrote to its transcript recently; the update is already installed and takes effect on
# that session's next start. Tune with AGENT_UPDATE_IDLE_MIN (minutes of silence that count
# as idle, default 60).
IDLE_MIN="${AGENT_UPDATE_IDLE_MIN:-60}"
case "$IDLE_MIN" in ''|*[!0-9]*) echo "WARNING: AGENT_UPDATE_IDLE_MIN=$IDLE_MIN is not a number, using 60"; IDLE_MIN=60 ;; esac
recent_session() {  # recent_session <user> <claude-rc|codex-rc> -> prints one recently written session file, exit 0 if any
  local u="$1" dir
  case "$2" in
    claude-rc) dir="$HOME_ROOT/$u/.claude/projects" ;;
    codex-rc)  dir="$HOME_ROOT/$u/.codex/sessions" ;;
    *) return 1 ;;
  esac
  [ -d "$dir" ] || return 1
  local hit
  hit=$(find "$dir" -type f \( -name '*.jsonl' -o -name '*.json' \) -mmin "-$IDLE_MIN" -print -quit 2>/dev/null)
  [ -n "$hit" ] && { echo "$hit"; return 0; }
  return 1
}

for u in $(cat "$USERS_FILE"); do
  id "$u" >/dev/null 2>&1 || continue
  for s in claude-rc codex-rc; do
    systemctl is-enabled "$s@$u" >/dev/null 2>&1 || continue
    if active=$(recent_session "$u" "$s"); then
      echo "SKIPPED restart of $s@$u: a session was active in the last ${IDLE_MIN} min ($active)"
      continue
    fi
    systemctl restart "$s@$u" && echo "restarted $s@$u"
  done
done

# ndev is deliberately NOT restarted: nothing here changes Next.js, and bouncing it would
# drop the live site for no reason.
echo "=== done ==="
