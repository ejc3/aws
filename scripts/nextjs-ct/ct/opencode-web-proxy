#!/usr/bin/env python3
"""Authenticate the same-origin browser to OpenCode after the tunnel validates Cloudflare Access.

The upstream password remains in a private runtime file, never HTML, browser storage, URLs or argv. nginx carries HTTP
streams and WebSockets. Only the container's host gateway and loopback can reach this proxy; the native server stays
on loopback and still requires its own credential.
"""
import base64
import ipaddress
import json
import os
import subprocess
import sys
from pathlib import Path


def prepare_assets(runtime):
    """Only public code is served here; upstream credentials remain in nginx.conf."""
    source = Path(__file__).resolve().parent
    for name in ("service-worker.js", "access-refresh.html"):
        target = Path(runtime) / name
        content = (source / ("opencode-web-" + name)).read_bytes()
        if not target.exists() or target.read_bytes() != content:
            temporary = target.with_suffix(target.suffix + ".new")
            temporary.write_bytes(content)
            temporary.chmod(0o600)
            temporary.replace(target)


def configuration(spec, password, gateway, runtime):
    gateway = str(ipaddress.IPv4Address(gateway))
    hostname = spec["hostname"]
    if not hostname or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789.-" for c in hostname):
        raise ValueError("invalid OpenCode hostname")
    port, upstream = int(spec["proxy_port"]), int(spec["port"])
    if not (1024 <= port <= 65535 and 1024 <= upstream <= 65535 and port != upstream and password):
        raise ValueError("invalid OpenCode proxy configuration")
    auth = base64.b64encode(("opencode:" + password).encode()).decode()
    return f'''pid {runtime}/nginx.pid;
error_log stderr warn;
events {{ worker_connections 128; }}
http {{
    access_log off;
    map $http_upgrade $connection_upgrade {{ default upgrade; '' close; }}
    map $http_origin $origin_allowed {{ default 0; '' 1; "https://{hostname}" 1; }}
    client_body_temp_path {runtime}/body;
    proxy_temp_path {runtime}/proxy;
    server {{
        listen {port};
        server_name {hostname};
        allow 127.0.0.1;
        allow {gateway};
        deny all;
        if ($host != "{hostname}") {{ return 421; }}
        if ($origin_allowed = 0) {{ return 403; }}
        client_max_body_size 32m;
        location = /sw.js {{
            alias {runtime}/service-worker.js;
            default_type application/javascript;
            etag off;
            if_modified_since off;
            add_header Cache-Control "no-store" always;
            add_header Service-Worker-Allowed "/" always;
            add_header X-Content-Type-Options "nosniff" always;
            limit_except GET {{ deny all; }}
        }}
        location = /auth/access-refresh {{
            alias {runtime}/access-refresh.html;
            default_type text/html;
            etag off;
            if_modified_since off;
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "no-referrer" always;
            limit_except GET {{ deny all; }}
        }}
        location / {{
            proxy_pass http://127.0.0.1:{upstream};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Authorization "Basic {auth}";
            proxy_set_header Cf-Access-Jwt-Assertion "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
        }}
    }}
}}
'''


def main():
    if sys.argv[1:] not in ([], ["--reload"]):
        raise SystemExit("usage: opencode-web-proxy [--reload]")
    os.umask(0o077)
    spec = json.loads(Path("/opt/nextjs-ct/config.json").read_text())["opencode_web"]
    password = json.loads((Path.home() / ".config/opencode/service.json").read_text())["password"]
    # Identity files under /opt/nextjs-ct-user are root-only. Use the same UID-derived address as the host router.
    uid = os.getuid()
    if not 1001 <= uid <= 1254:
        raise ValueError("OpenCode proxy must run as a container account")
    gateway = f"10.88.{uid - 1000}.1"
    runtime = Path(os.environ["RUNTIME_DIRECTORY"])
    path = runtime / "nginx.conf"
    content = configuration(spec, password, gateway, runtime)
    prepare_assets(runtime)
    if sys.argv[1:] == ["--reload"]:
        # Reconfigure only this proxy, gracefully preserving active event streams.
        if path.exists() and path.read_text() == content:
            return
        candidate = runtime / "nginx.conf.new"
        candidate.write_text(content)
        candidate.chmod(0o600)
        check = subprocess.run(["/usr/sbin/nginx", "-p", str(runtime) + "/", "-c", str(candidate), "-t"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if check.returncode:
            candidate.unlink()
            raise SystemExit("OpenCode proxy configuration rejected; keeping the running configuration")
        candidate.replace(path)
        subprocess.run(["/usr/sbin/nginx", "-p", str(runtime) + "/", "-c", str(path), "-s", "reload"], check=True)
        return
    path.write_text(content)
    path.chmod(0o600)
    os.execv("/usr/sbin/nginx", ["nginx", "-p", str(runtime) + "/", "-c", str(path), "-g", "daemon off;"])


if __name__ == "__main__":
    main()
