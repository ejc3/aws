[Unit]
# The agent reads its certificate once, when it starts. Enrolling swaps a new ~/.config/claude-master in, and so does the daily
# renewal (claw-master-cert-renew.tf, which never restarts anything itself): either one sets the agent up again.
Description=Set up the claw-master agent again for %i when its client certificate changes

[Path]
PathChanged=/home/%i/.config/claude-master/client.pem
Unit=claw-master-agent-setup@%i.service

[Install]
WantedBy=multi-user.target
