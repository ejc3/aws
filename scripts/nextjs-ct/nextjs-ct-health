#!/bin/bash
# nextjs-ct-health -- is the host set up? setup-sync records a published script only when this passes,
# so a half-done setup is retried rather than remembered as applied. Prints what is wrong; exit 1 if anything is.
set -uo pipefail
BAD=""
for cmd in aws jq nft systemd-nspawn machinectl debootstrap rsync; do
  command -v "$cmd" >/dev/null 2>&1 || BAD="$BAD missing:$cmd"
done
[ -x /usr/local/bin/setup-sync ] || BAD="$BAD missing:setup-sync"
systemctl is-enabled --quiet setup-sync.timer 2>/dev/null || BAD="$BAD disabled:setup-sync.timer"
systemctl is-active --quiet snap.amazon-ssm-agent.amazon-ssm-agent.service 2>/dev/null \
  || systemctl is-active --quiet amazon-ssm-agent.service 2>/dev/null || BAD="$BAD down:ssm-agent"
if [ -n "$BAD" ]; then
  echo "nextjs-ct-health: NOT healthy:$BAD"
  exit 1
fi
echo "nextjs-ct-health: healthy"
