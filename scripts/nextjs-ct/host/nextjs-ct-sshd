#!/bin/bash
# nextjs-ct-sshd -- the host sshd's per-account rules, regenerated from config.json and checked with
# `sshd -t` before sshd is reloaded (a reload keeps every open session).
#
# Every account in config.json is carried into its own container by nextjs-ct-enter; nobody gets a
# shell on the host (the admin account, ubuntu, is not listed and is unaffected). What ssh can forward:
#   -L / -W   only to the account's own container address (ssh -L 3000:10.88.N.2:3000 ...)
#   -R        nothing
#   agent     forwarded through to the container
#   X11, tun, unix sockets   no
set -euo pipefail
CONFIG=/etc/nextjs-ct/config.json
OUT=/etc/ssh/sshd_config.d/90-nextjs-ct.conf
{
  echo "# Generated by nextjs-ct-sshd from $CONFIG -- do not edit."
  echo "AcceptEnv LANG LC_* COLORTERM"
  for U in $(jq -r '.users | keys[]' "$CONFIG"); do
    id -u "$U" >/dev/null 2>&1 || continue
    N=$(( $(id -u "$U") - 1000 ))
    echo ""
    echo "Match User $U"
    echo "    ForceCommand /usr/local/sbin/nextjs-ct-enter"
    # A member may also forward to their own boxes (RDP or DCV to their wbox, say); never another member's.
    OPEN="10.88.$N.2:*"
    for ip in $(jq -r --arg u "$U" '.users[$u].box_ips // [] | .[]' "$CONFIG"); do OPEN+=" $ip:*"; done
    echo "    PermitOpen $OPEN"
    echo "    AllowTcpForwarding local"
    echo "    PermitListen none"
    echo "    AllowAgentForwarding yes"
    echo "    AllowStreamLocalForwarding no"
    echo "    X11Forwarding no"
    echo "    PermitTunnel no"
    echo "    PermitUserRC no"
  done
  echo ""
  echo "Match all"
} > "$OUT.new"
chmod 644 "$OUT.new"
if cmp -s "$OUT.new" "$OUT"; then rm -f "$OUT.new"; exit 0; fi
cp "$OUT" "$OUT.prev" 2>/dev/null || true
mv -f "$OUT.new" "$OUT"
if ! sshd -t; then
  echo "nextjs-ct-sshd: sshd rejected the new rules; restoring the previous file" >&2
  if [ -e "$OUT.prev" ]; then mv -f "$OUT.prev" "$OUT"; else rm -f "$OUT"; fi
  exit 1
fi
systemctl reload ssh.service
echo "nextjs-ct-sshd: rules for $(jq -r '.users | length' "$CONFIG") accounts loaded"
