#!/bin/bash
# nextjs-ct-firewall -- the containers' network boundary, regenerated from config.json and loaded
# atomically (one nft transaction replaces both tables). Run by nextjs-ct-firewall.service before any
# container starts, and by the host setup when the account list changes.
#
# Each container has its own network namespace on a point-to-point link: host 10.88.N.1, container
# 10.88.N.2, N = uid - 1000 (derived, never allocated). What a container may do:
#   out to the internet and the VPC     forwarded and masqueraded as the host (IPv4 only)
#   169.254.169.254:80                  redirected to the host's nextjs-ct-imds on its own gateway, which
#                                       answers with that container's own narrowed AWS session
#   169.254.169.253:53                  the VPC resolver (forwarded like any other traffic)
#   its own gateway, port 2222          the MacBook's reverse tunnel, owner accounts only (config.json
#                                       users.<u>.mac): the Mac's listener is on the host's loopback
#                                       and nextjs-ct-mac-tunnel.socket relays it to the owner only
# A member's container (not the owner's) is also refused the io-box NFS scratch (config.json io_box_ip).
# and nothing else: no other container, no other host port (sshd, the metadata service itself, any
# loopback listener), no address but its own as the source, and no IPv6.
set -euo pipefail
CONFIG=/etc/nextjs-ct/config.json
OUT=/etc/nextjs-ct/firewall.nft
PORT=8169

IO_BOX=$(jq -r '.io_box_ip // empty' "$CONFIG")
nat="" input="" fwd=""
for U in $(jq -r '.users | keys[]' "$CONFIG"); do
  id -u "$U" >/dev/null 2>&1 || continue
  N=$(( $(id -u "$U") - 1000 ))
  [ "$N" -ge 1 ] && [ "$N" -le 254 ] || continue
  IF="ve-$U"; IF=${IF:0:15}
  nat+="    iifname \"$IF\" ip saddr 10.88.$N.2 ip daddr 169.254.169.254 tcp dport 80 dnat to 10.88.$N.1:$PORT"$'\n'
  fwd+="    iifname \"$IF\" ip saddr != 10.88.$N.2 drop"$'\n'
  # The io-box NFS scratch is the owner's: a member's traffic would otherwise leave as the host and be admitted.
  if [ "$(jq -r --arg u "$U" '.users[$u].owner // false' "$CONFIG")" != true ] && [ -n "$IO_BOX" ]; then
    fwd+="    iifname \"$IF\" ip daddr $IO_BOX drop"$'\n'
  fi
  # A second bound under the credential server's own per-container cap: at most 16 connections at once.
  input+="    iifname \"$IF\" tcp dport $PORT ct count over 16 drop"$'\n'
  input+="    iifname \"$IF\" ip saddr 10.88.$N.2 ip daddr 10.88.$N.1 tcp dport $PORT ct status dnat accept"$'\n'
  if [ "$(jq -r --arg u "$U" '.users[$u].mac // false' "$CONFIG")" = true ]; then
    input+="    iifname \"$IF\" ip saddr 10.88.$N.2 ip daddr 10.88.$N.1 tcp dport 2222 accept"$'\n'
  fi
done

cat > "$OUT.new" <<EOF
# Generated by nextjs-ct-firewall from $CONFIG -- do not edit.
table ip nextjs_ct_nat
delete table ip nextjs_ct_nat
table inet nextjs_ct_filter
delete table inet nextjs_ct_filter

table ip nextjs_ct_nat {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
$nat  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr 10.88.0.0/16 oifname != "ve-*" masquerade
  }
}

table inet nextjs_ct_filter {
  chain input {
    type filter hook input priority filter; policy accept;
    iifname != "ve-*" accept
    ct state established,related accept
$input    drop
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    iifname "ve-*" meta nfproto ipv6 drop
$fwd    iifname "ve-*" oifname "ve-*" drop
    iifname "ve-*" ip daddr 169.254.169.254 drop
    iifname "ve-*" accept
  }
}
EOF
nft -c -f "$OUT.new"
mv -f "$OUT.new" "$OUT"
sysctl -q -w net.ipv4.ip_forward=1
nft -f "$OUT"
echo "nextjs-ct-firewall: loaded"
