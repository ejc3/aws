+  # Local patch: a request without this server's token is refused before its body is read, so the larger body limit
+  # above is available only to callers holding the token.
+  defp require_token(%Plug.Conn{method: "GET"} = conn, _opts), do: conn
+
+  defp require_token(conn, _opts) do
+    expected = "Bearer " <> (System.get_env("SRH_TOKEN") || "")
+
+    case Plug.Conn.get_req_header(conn, "authorization") do
+      [header] when byte_size(expected) > 7 ->
+        if Plug.Crypto.secure_compare(header, expected), do: conn, else: refuse(conn)
+
+      _ ->
+        refuse(conn)
+    end
+  end
+
+  defp refuse(conn) do
+    conn
+    |> Plug.Conn.put_resp_content_type("application/json")
+    |> Plug.Conn.send_resp(401, ~s({"error":"Unauthorized"}))
+    |> Plug.Conn.halt()
+  end
+
   defp do_command_request(conn, success_lambda) do
     encoding_enabled = handle_extract_encoding?(conn)
 
