#!/bin/sh
# Installed in the Mac mini's CI VM as ~/.local/sim-shims/xcodebuild (a symlink), first on every runner's PATH (its
# .path) by scripts/mac-vm-setup.sh --runners. A simulator test run, `xcodebuild test` or `test-without-building`,
# takes one of CI_SIM_SLOTS (2) slots through mac-build, waiting and saying so once while every slot is held; any
# other xcodebuild (build, archive, -list) runs at once. The pool's four runners share the VM's 9 CPUs: four
# simulators at once put the load at 137 to 1022 with the app under test at 0 to 10% of the CPU, and its UI tests hung.
# Builds keep their runners and their CPU; only the simulators wait.
real=${SIM_REAL_XCODEBUILD:-/usr/bin/xcodebuild}
# Already inside a slot (mac-build sets MAC_BUILD_SLOT for its command and its children): run at once.
[ -n "${MAC_BUILD_SLOT:-}" ] && exec "$real" "$@"

# xcodebuild's actions are bare words. A word right after an option is that option's value (-scheme test), except
# after the options that take none.
prev=""
for a in "$@"; do
  case "$prev" in
    -quiet|-verbose|-json|-allowProvisioningUpdates|-allowProvisioningDeviceRegistration|-skipPackagePluginValidation|\
    -skipMacroValidation|-parallelizeTargets|-showBuildTimingSummary|-hideShellScriptEnvironment|-skipUnavailableActions|\
    -disableAutomaticPackageResolution|-onlyUsePackageVersionsFromResolvedFile|-skipPackageUpdates|-skip-testing:*|\
    -only-testing:*|-skip-test-configuration:*|-only-test-configuration:*) ;;
    -*) prev=""; continue ;;
  esac
  case "$a" in
    test|test-without-building)
      MAC_STATE_DIR=${CI_SIM_STATE_DIR:-$HOME/.local/state/sim-slots} MAC_BUILD_SLOTS=${CI_SIM_SLOTS:-2} \
        exec "${MAC_BUILD:-$HOME/.local/bin/mac-build}" "$real" "$@" ;;
  esac
  prev=$a
done
exec "$real" "$@"
