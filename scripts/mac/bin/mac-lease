#!/usr/bin/perl
# mac-lease: who is driving the MacBook's desktop right now. Advisory and lightweight: it keeps two
# sessions' clicks, typing and app relaunches from interleaving, nothing more.
#
#   mac-lease take NAME [--ttl SECONDS] [--wait SECONDS]   hold it (renews if NAME already holds it)
#   mac-lease release NAME                                  give it back (only its holder can)
#   mac-lease run NAME [--ttl S] [--wait S] -- CMD [ARGS]   take, run CMD, release; exit status is CMD's
#   mac-lease check [NAME]                                  0 if free or held by NAME, 75 if someone else holds it
#   mac-lease status                                        print the holder, or "free"
#
# A `take`'s lease ends when released or at its expiry (default ttl 600 s). A `run`'s lease ends when the
# command process exits, however long it runs: --ttl does not cut it short. `take` fails
# with 75 while another live lease exists, unless --wait gives it time.
# Waiters get the lease in arrival order; a ticket ends with its deadline or waiting process.
# Only a pid-less lease is renewed or released by name across separate calls.
# Installed by ejc3/aws scripts/mac-setup.sh; state in ~/.local/state/mac-lease (MAC_STATE_DIR overrides).
use strict;
use warnings;
use Errno qw(EINTR EPERM);
use Fcntl qw(:flock O_RDWR O_CREAT);
use File::Path qw(make_path);
use POSIX qw(_exit strftime);

my $dir = ($ENV{MAC_STATE_DIR} // "$ENV{HOME}/.local/state") . "/mac-lease";
make_path($dir, { mode => 0700 });
my $file = "$dir/lease";
my $queue = "$dir/queue";
make_path($queue, { mode => 0700 });

sub usage { print STDERR "usage: mac-lease take|release|run|check|status ... (see the top of $0)\n"; exit 2 }

sub locked(&) {
    my ($code) = @_;
    sysopen(my $fh, "$dir/lock", O_RDWR | O_CREAT, 0600) or die "mac-lease: $dir/lock: $!\n";
    flock($fh, LOCK_EX) or die "mac-lease: lock: $!\n";
    my @r = $code->();
    close $fh;
    return wantarray ? @r : $r[0];
}

# The PID alone can be recycled after an interrupted run. ps is present on macOS and Linux.
sub process_identity {
    my ($pid) = @_;
    local $ENV{LC_ALL} = 'C';
    local $ENV{TZ} = 'UTC';
    open(my $ps, '-|', '/bin/ps', '-p', $pid, '-o', 'stat=', '-o', 'lstart=') or return;
    my $row = <$ps>;
    return unless close($ps) && defined $row;
    return ($2, $1) if $row =~ /^\s*(\S+)\s+(.+?)\s*$/;
    return;
}

sub read_lease {
    my ($include_dead) = @_;
    open(my $fh, '<', $file) or return undef;
    my $line = <$fh>;
    close $fh;
    return undef unless defined $line;
    chomp $line;
    my ($name, $expiry, $pid, $since, $birth) = split /\t/, $line;
    return undef unless defined $expiry && $expiry =~ /^\d+$/;
    my $run = $pid && $pid =~ /^\d+$/ && $pid > 0;
    if ($run && !$include_dead) {
        return undef if !kill(0, $pid) && $! != EPERM;
        my ($actual, $state) = process_identity($pid);
        # A transient ps failure is not proof that an otherwise live lease lost its process.
        return undef if defined $state && ($state =~ /^Z/ || (defined $birth && $actual ne $birth));
    }
    return undef if !$run && $expiry <= time;                          # a `take`'s, expired
    return { name => $name, expiry => $expiry, pid => $pid // 0, since => $since // $expiry, birth => $birth };
}

sub describe {
    my ($l) = @_;
    return sprintf("%s (since %s, %s)", $l->{name}, strftime("%H:%M:%S", localtime $l->{since}),
        $l->{pid} ? "while pid $l->{pid} runs" : "until " . strftime("%H:%M:%S", localtime $l->{expiry}));
}

sub write_lease {
    my ($name, $ttl, $pid, $since) = @_;
    my ($birth) = $pid ? process_identity($pid) : ('');
    defined($birth) or die "mac-lease: cannot identify command process $pid\n";
    my $tmp = "$file.$$";
    open(my $fh, '>', $tmp) or die "mac-lease: $tmp: $!\n";
    chmod 0600, $tmp;
    print $fh join("\t", $name, time + $ttl, $pid, $since, $birth), "\n";
    close $fh or die "mac-lease: $tmp: $!\n";
    rename $tmp, $file or die "mac-lease: $file: $!\n";
}

sub options {
    my ($args) = @_;
    my %o = (ttl => 600, wait => 0);
    while (@$args && $args->[0] =~ /^--(ttl|wait)(?:=(\d+))?$/) {
        my ($k, $v) = ($1, $2);
        shift @$args;
        $v = shift @$args unless defined $v;
        defined $v && $v =~ /^\d+$/ or usage();
        $o{$k} = $v;
    }
    return \%o;
}

# The live tickets, oldest first: [path, name]. A ticket whose waiting process is gone is removed.
# Called under the lock.
sub tickets {
    my ($vacant) = @_;
    opendir(my $dh, $queue) or return ();
    my @t;
    for my $f (sort grep { /^\d{12}-\d+-/ } readdir $dh) {
        my ($pid, $name) = $f =~ /^\d{12}-(\d+)-(.+)$/ or next;
        my $path = "$queue/$f";
        my $until;
        if (open(my $fh, '<', $path)) { $until = <$fh>; close $fh; }
        # A live but stopped or hung waiter cannot reserve a free desktop past its deadline.
        if (!defined $until || $until !~ /^\d+\n?$/ || $until <= time || !kill(0, $pid)) {
            unlink $path;
            next;
        }
        push @t, [$path, $name, $pid];
    }
    closedir $dh;
    # The kernel still finds an unreaped child by PID. Check the ticket about to get a
    # free desktop; while a lease is held there is no need to run ps for every waiter.
    while ($vacant && @t) {
        my (undef, $state) = process_identity($t[0][2]);
        last unless defined $state && $state =~ /^Z/;
        unlink $t[0][0];
        shift @t;
    }
    return @t;
}

# A new ticket for this process, numbered after every earlier one. Called under the lock.
sub enqueue {
    my ($name, $deadline) = @_;
    my $n = 0;
    if (open(my $fh, '<', "$dir/seq")) { my $v = <$fh>; close $fh; $n = $1 if defined $v && $v =~ /^(\d+)/; }
    $n++;
    open(my $out, '>', "$dir/seq.$$") or die "mac-lease: $dir/seq.$$: $!\n";
    print $out "$n\n";
    close $out or die "mac-lease: $dir/seq: $!\n";
    rename "$dir/seq.$$", "$dir/seq" or die "mac-lease: $dir/seq: $!\n";
    my $path = sprintf("%s/%012d-%d-%s", $queue, $n, $$, $name);
    open(my $t, '>', $path) or die "mac-lease: $path: $!\n";
    print $t "$deadline\n";
    close $t or die "mac-lease: $path: $!\n";
    return $path;
}

sub take {
    my ($name, $o, $pid) = @_;
    my $deadline = time + $o->{wait};
    my ($said, $ticket);
    my $leave = sub { locked { unlink $ticket if $ticket } };
    while (1) {
        my ($holder, $ahead) = locked {
            my $l = read_lease();
            if ($l && $l->{name} eq $name && (!$l->{pid} || $l->{pid} == $pid) && (!$ticket || time < $deadline)) {
                # A command under a manual lease borrows it without changing its deadline.
                write_lease($name, $o->{ttl}, $l->{pid}, $l->{since}) unless $pid && !$l->{pid};
                unlink $ticket if $ticket;
                return (undef, 0);
            }
            my @q = tickets(!$l);
            if (!$l && (!@q || ($ticket && $q[0][0] eq $ticket)) && (!$ticket || time < $deadline)) {   # free, and nobody queued before this one
                write_lease($name, $o->{ttl}, $pid, time);
                unlink $ticket if $ticket;
                return (undef, 0);
            }
            $ticket = enqueue($name, $deadline) if !$ticket && $o->{wait} > 0 && time < $deadline;
            my $before = grep { !$ticket || $_->[0] lt $ticket } @q;
            return ($l // { name => (@q ? $q[0][1] : ""), queued => 1 }, $before);
        };
        return 0 unless $holder;
        if (time >= $deadline) {
            $leave->();
            print STDERR $holder->{queued}
                ? ($ahead ? "mac-lease: free, but $ahead queued before you (first: $holder->{name})\n"
                    : "mac-lease: desktop wait expired\n")
                : "mac-lease: the desktop is held by " . describe($holder) . ($ahead ? ", $ahead queued before you" : "") . "\n";
            return 75;
        }
        print STDERR "mac-lease: waiting for ", ($holder->{queued} ? "$holder->{name} (queued first)" : describe($holder)),
            ($ahead ? ", $ahead queued before you" : ""), "\n" unless $said++;
        sleep 1;
    }
}

sub wait_command {
    my ($pid) = @_;
    my $waited;
    do { $waited = waitpid($pid, 0); } while ($waited == -1 && $! == EINTR);
    return $waited == $pid ? $? : -1;
}

my $cmd = shift @ARGV // usage();
my $name_ok = sub { defined $_[0] && $_[0] =~ /^[A-Za-z0-9._:@+-]{1,64}$/ or do { print STDERR "mac-lease: NAME is 1-64 of [A-Za-z0-9._:@+-]\n"; exit 2 } };

if ($cmd eq 'status') {
    my $l = locked { read_lease() };
    print $l ? describe($l) . "\n" : "free\n";
    exit 0;
} elsif ($cmd eq 'check') {
    my $name = shift @ARGV // '';
    my $l = locked { read_lease() };
    exit 0 if !$l || ($name ne '' && $l->{name} eq $name);
    print STDERR "mac-lease: the desktop is held by ", describe($l), "\n";
    exit 75;
} elsif ($cmd eq 'take') {
    my $name = shift @ARGV; $name_ok->($name);
    my $o = options(\@ARGV);
    @ARGV and usage();
    exit take($name, $o, 0);
} elsif ($cmd eq 'release') {
    my $name = shift @ARGV; $name_ok->($name);
    my $rc = locked {
        my $l = read_lease();
        return 0 unless $l;
        return 75 unless $l->{name} eq $name;
        return 76 if $l->{pid};   # a live `run`'s lease ends with it
        unlink $file;
        return 0;
    };
    print STDERR $rc == 76 ? "mac-lease: $name is held by a running `run` (it ends with it)\n" : "mac-lease: not held by $name\n" if $rc;
    $rc = 75 if $rc == 76;
    exit $rc;
} elsif ($cmd eq 'run') {
    my $name = shift @ARGV; $name_ok->($name);
    my $o = options(\@ARGV);
    shift @ARGV if @ARGV && $ARGV[0] eq '--';
    @ARGV or usage();
    # The command PID holds the lease, even if the caller is killed while waiting
    # for it. EOF before the parent's permit means the command must never run.
    pipe(my $start_in, my $start_out) or die "mac-lease: pipe: $!\n";
    my $pid = fork();
    defined $pid or die "mac-lease: fork: $!\n";
    if (!$pid) {
        close $start_out;
        my ($permit, $received);
        do { $received = sysread($start_in, $permit, 1); } while (!defined($received) && $! == EINTR);
        close $start_in;
        _exit(75) unless defined($received) && $received == 1 && $permit eq '1';
        $ENV{MAC_LEASE} = $name;
        exec { $ARGV[0] } @ARGV or _exit(127);
    }
    close $start_in;
    my ($birth) = process_identity($pid);
    defined($birth) or die "mac-lease: cannot identify command process $pid\n";
    my $rc = take($name, $o, $pid);
    if (!$rc) {
        # A signal may have stopped the child before it could read the permit.
        # Close and reap it normally even when writing would raise SIGPIPE.
        local $SIG{PIPE} = 'IGNORE';
        my $sent;
        do { $sent = syswrite($start_out, '1'); } while (!defined($sent) && $! == EINTR);
    }
    close $start_out;
    my $status = wait_command($pid);
    exit $rc if $rc;
    locked {
        my $l = read_lease(1);
        unlink $file if $l && $l->{name} eq $name && $l->{pid} == $pid && ($l->{birth} // "") eq $birth;
    };
    exit 127 if $status == -1;
    exit($status & 127 ? 128 + ($status & 127) : $status >> 8);
} else {
    usage();
}
