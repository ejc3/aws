# dolphin-relay.tf
#
# The Dolphin Browser relay (dolphin-labs-hq/dolphin-browser, `relay/`): a public Cloudflare Worker with a Durable Object
# and a D1 database, deployed from that repository's CI on merge to main (#397). Owner decisions (2026-10-12):
#
#   - No Cloudflare deploy token on the dev boxes. This repo's token lives ONLY in a protected GitHub environment,
#     `relay`, in dolphin-browser, whose deployment policy admits the `main` branch alone; the deploy job names that
#     environment. Workers Scripts Write cannot be scoped to one Worker (it reaches every Worker in the account,
#     production included), so the environment's branch rule is what keeps it to reviewed code.
#   - Invite-only signup: SIGNUP_TOKEN is generated here, kept in Secrets Manager for the dev boxes (`dolphin init
#     --relay ... ` needs it to create an account), and given to the same environment, so the deploy sets the Worker
#     secret on every deploy (`wrangler secret put` in relay/scripts/deploy.ts). No dev box is involved in the deploy.
#
# The D1 database is created by that deploy (deploy.ts finds `dolphin-relay` by name and creates it once), not here:
# the Cloudflare provider's token has no D1 permission, and the deploy token needs D1 Write for the migrations anyway.
#
# Values in state: the deploy token and the signup token, as with the other tokens Terraform mints (workers-deploy.tf);
# state is administration-only. ROTATE: `terraform apply -replace=cloudflare_account_token.dolphin_relay_deploy` or
# `-replace=random_password.dolphin_relay_signup`; Terraform rewrites the container and the environment secret, and the
# next deploy picks them up (a new signup token does not invalidate existing relay accounts).

locals {
  dolphin_relay_repository  = "dolphin-browser"
  dolphin_relay_environment = "relay"
  # D1 Write (GET /accounts/<id>/tokens/permission_groups), pinned by scripts/test-dolphin-relay.py.
  d1_write = "09b2857d1c31407795e75e3fed8617a1"

  dolphin_relay_github_app = jsondecode(ephemeral.aws_secretsmanager_secret_version.dolphin_relay_github_app.secret_string)
}

# ------------------------------------------------------------------------------------------------ deploy token
resource "cloudflare_account_token" "dolphin_relay_deploy" {
  provider   = cloudflare.token_minter
  account_id = var.cloudflare_account_id
  name       = "dolphin-relay-deploy"
  policies = [{
    effect            = "allow"
    permission_groups = [{ id = local.workers_scripts_write }, { id = local.d1_write }, { id = local.account_settings_read }]
    resources         = jsonencode({ "com.cloudflare.api.account.${var.cloudflare_account_id}" = "*" })
  }]
}

# A record of the token for administrators (rotation checks, a manual deploy in an emergency). Never readable by a dev
# box: that is the owner's decision above.
resource "aws_secretsmanager_secret" "dolphin_relay_deploy_token" {
  name                    = "dolphin-browser/relay-deploy-token"
  description             = "Cloudflare token the dolphin-browser relay deploys with (Workers Scripts Write, D1 Write, Account Settings Read). Written by Terraform; dolphin-relay.tf. Administration only."
  recovery_window_in_days = 7
  tags                    = { Name = "dolphin-browser/relay-deploy-token", Project = "dolphin-browser" }
}

resource "aws_secretsmanager_secret_policy" "dolphin_relay_deploy_token" {
  secret_arn = aws_secretsmanager_secret.dolphin_relay_deploy_token.arn
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "OnlyAdministrationCanRead"
      Effect    = "Deny"
      Principal = "*"
      Action    = "secretsmanager:GetSecretValue"
      Resource  = aws_secretsmanager_secret.dolphin_relay_deploy_token.arn
      Condition = { ArnNotLike = { "aws:PrincipalArn" = local.games_mp_admin_principals } }
    }]
  })
}

resource "aws_secretsmanager_secret_version" "dolphin_relay_deploy_token" {
  secret_id     = aws_secretsmanager_secret.dolphin_relay_deploy_token.id
  secret_string = cloudflare_account_token.dolphin_relay_deploy.value
}

# ------------------------------------------------------------------------------------------------ signup token
resource "random_password" "dolphin_relay_signup" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "dolphin_relay_signup" {
  name                    = "dolphin-browser/signup-token"
  description             = "The relay's invite token (SIGNUP_TOKEN): `dolphin init --relay <url>` needs it to create an account. Generated by Terraform; dolphin-relay.tf. Readable by administration and the metal boxes."
  recovery_window_in_days = 7
  tags                    = { Name = "dolphin-browser/signup-token", Project = "dolphin-browser" }
}

locals {
  dolphin_relay_signup_readers = [aws_iam_role.dev_server.arn]
}

resource "aws_secretsmanager_secret_policy" "dolphin_relay_signup" {
  secret_arn = aws_secretsmanager_secret.dolphin_relay_signup.arn
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "OnlyAdministrationAndTheMetalBoxesCanRead"
      Effect    = "Deny"
      Principal = "*"
      Action    = "secretsmanager:GetSecretValue"
      Resource  = aws_secretsmanager_secret.dolphin_relay_signup.arn
      Condition = { ArnNotLike = { "aws:PrincipalArn" = concat(local.games_mp_admin_principals, local.dolphin_relay_signup_readers) } }
    }]
  })
}

resource "aws_secretsmanager_secret_version" "dolphin_relay_signup" {
  secret_id     = aws_secretsmanager_secret.dolphin_relay_signup.id
  secret_string = random_password.dolphin_relay_signup.result
}

data "aws_iam_policy_document" "dolphin_relay_signup_read" {
  statement {
    sid       = "ReadTheRelaySignupToken"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [aws_secretsmanager_secret.dolphin_relay_signup.arn]
  }
}

resource "aws_iam_policy" "dolphin_relay_signup_read" {
  name        = "dev-dolphin-relay-signup-read"
  description = "Metal boxes: read the Dolphin relay's invite token (dolphin-browser/signup-token) and nothing else"
  policy      = data.aws_iam_policy_document.dolphin_relay_signup_read.json
}

resource "aws_iam_role_policy_attachment" "dolphin_relay_signup_read" {
  role       = aws_iam_role.dev_server.name
  policy_arn = aws_iam_policy.dolphin_relay_signup_read.arn
}

# ------------------------------------------------------------------------------------------------ GitHub environment
# The administration agent's GitHub App (github-admin-tokens.tf), installed on dolphin-labs-hq with environments,
# secrets and variables write. Its key is read ephemerally and never reaches state.
ephemeral "aws_secretsmanager_secret_version" "dolphin_relay_github_app" {
  secret_id = aws_secretsmanager_secret.github_app_admin.id
}

provider "github" {
  alias = "dolphin_relay"
  owner = "dolphin-labs-hq"
  app_auth {
    id              = tostring(local.dolphin_relay_github_app.app_id)
    installation_id = tostring(local.dolphin_relay_github_app.installations["dolphin-labs-hq"])
    pem_file        = local.dolphin_relay_github_app.private_key
  }
}

# Only a job running on `main` may enter this environment, so only reviewed code gets the token.
resource "github_repository_environment" "dolphin_relay" {
  provider    = github.dolphin_relay
  repository  = local.dolphin_relay_repository
  environment = local.dolphin_relay_environment
  deployment_branch_policy {
    protected_branches     = false
    custom_branch_policies = true
  }
}

resource "github_repository_environment_deployment_policy" "dolphin_relay_main" {
  provider       = github.dolphin_relay
  repository     = local.dolphin_relay_repository
  environment    = github_repository_environment.dolphin_relay.environment
  branch_pattern = "main"
}

resource "github_actions_environment_secret" "dolphin_relay_cloudflare_token" {
  provider        = github.dolphin_relay
  repository      = local.dolphin_relay_repository
  environment     = github_repository_environment.dolphin_relay.environment
  secret_name     = "CLOUDFLARE_API_TOKEN"
  plaintext_value = cloudflare_account_token.dolphin_relay_deploy.value
}

resource "github_actions_environment_secret" "dolphin_relay_signup" {
  provider        = github.dolphin_relay
  repository      = local.dolphin_relay_repository
  environment     = github_repository_environment.dolphin_relay.environment
  secret_name     = "SIGNUP_TOKEN"
  plaintext_value = random_password.dolphin_relay_signup.result
}

resource "github_actions_environment_variable" "dolphin_relay_account" {
  provider      = github.dolphin_relay
  repository    = local.dolphin_relay_repository
  environment   = github_repository_environment.dolphin_relay.environment
  variable_name = "CLOUDFLARE_ACCOUNT_ID"
  value         = var.cloudflare_account_id
}

output "dolphin_relay" {
  description = "Where the Dolphin relay's deploy credentials live (no values)."
  value = {
    github_environment   = "dolphin-labs-hq/${local.dolphin_relay_repository}:${local.dolphin_relay_environment}"
    deploy_token_secret  = aws_secretsmanager_secret.dolphin_relay_deploy_token.name
    signup_token_secret  = aws_secretsmanager_secret.dolphin_relay_signup.name
    signup_token_readers = "administration, dev-server-role"
  }
}
