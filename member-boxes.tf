# member-boxes.tf
#
# EVERY MEMBER GETS THREE BOXES OF THEIR OWN. The owner, 2026-10-18: "give each kid and Steve a pbox and a gbox
# and a wbox; then I get my 4 boxes myself, plus the gpu and wbox." So each person in local.member_box_people has
#
#   wbox-<person>   a Windows spot box with an NVIDIA GPU and a persistent D: disk (member-wbox.tf)
#   pbox-<person>   a many-core Graviton spot box with a persistent work volume, in Ohio (member-pbox.tf)
#   gbox-<person>   a small NVIDIA Linux box for browser-game GPU tests, us-west-2 (member-gbox.tf)
#
# and the owner keeps what he has, unchanged: parallel-box .. parallel-box-4, gpu-box .. gpu-box-4 and wbox.
#
# ONE WAY TO USE THEM: the same commands everywhere, `pbox`, `gbox` and `wbox`. Run by a member's Unix account
# (the account name is the person: local.member_box_people) they act on that member's own box and take no slot
# number; run by anyone else (ubuntu on the metal boxes, ejc3) they behave exactly as before. The scripts carry the
# same list (MEMBERS=...), and scripts/test-member-boxes.py keeps the two equal.
#
# PER PERSON, BY TAG, so a session can be narrowed to one person. Every member box is Name-tagged
# "<kind>-<person>", every durable thing it uses is its own (launch template, volume, password, instance role, SSH
# key), and each grant (member-wbox-control, member-pbox-control, member-gbox-control) names them per person. The
# grants are attached to nextjs-dev-role only: the members work on nextjs-dev, and on its containerized replacement
# (nextjs-ct.tf), whose per-container sessions are that role narrowed by a session policy. output.member_boxes lists,
# per person, exactly what such a session policy has to name.
#
# A FIXED PRIVATE ADDRESS EACH, so a container's SSH PermitOpen (or firewall) can name it. The addresses sit in a
# small explicit subnet CIDR reservation per kind, which EC2 never hands out on its own, so nothing else can take
# one; a box that was just terminated may hold its address for a minute, and the scripts wait for it.
#   wbox: the member wbox subnet (10.0.69.0/24, us-west-1a): same VPC as nextjs-dev and nextjs-ct, reachable
#   gbox: the us-west-2a default subnet: reachable from the dev fleet over the I/O box peering (main.tf routes
#         the whole us-west-2 default VPC to it), and its security group admits SSH from the fleet subnets only
#   pbox: the Ohio pbox subnet: NOT routed from us-west-1 (Ohio peers only with the I/O box's VPC), so today it
#         is reached at its public address, as the owner's are; the private one is pinned for a future peering
#
# COST. Each kind is reaped like the owner's (the watchdogs: pbox and gbox after 30 idle minutes, wbox after an
# idle hour below 15% CPU) and, unlike the owner's pbox, every member box also has a hard lifetime enforced twice:
# the watchdog by LaunchTime, and the box's own deadline task (a timer the box re-arms at every boot, so a reboot
# does not disarm it).

locals {
  # The members, by their Unix account names on nextjs-dev (nextjs-user-data.tf local.nextjs_users, which also
  # has ejc3, the owner). Adding one here gives them all three boxes; the order fixes each person's address.
  member_box_people = ["colton", "connor", "colin", "skevh"]
  member_box_index  = { for i, p in local.member_box_people : p => i }

  # Hours from launch to the end of a member pbox or wbox, whatever it is doing (a member gbox has the owner's
  # var.gpu_box_max_hours).
  member_box_max_hours = 6
}

locals {
  member_box_ssh_arns = [for p in sort(local.member_box_people) : aws_secretsmanager_secret.member_box_ssh[p].arn]
}

# ============================================================ each member's SSH key
# The member pbox and gbox authorize exactly this key, so one person's key opens only their own two Linux boxes. The
# dev-hop key is not used: it opens every dev box, and the members do not hold it. `pbox` and `gbox` fetch the private
# half into ~/.ssh/member-box on first use. The private key is in Terraform state, as tls_private_key.dev_hop's is;
# state is administration-only.
resource "tls_private_key" "member_box" {
  for_each  = toset(local.member_box_people)
  algorithm = "ED25519"
}

resource "aws_secretsmanager_secret" "member_box_ssh" {
  for_each                = toset(local.member_box_people)
  name                    = "member-box/${each.key}/ssh-key"
  description             = "SSH private key for ${each.key}'s own pbox and gbox (member-boxes.tf). Generated by Terraform."
  recovery_window_in_days = 7
  tags                    = { Name = "member-box/${each.key}/ssh-key", Purpose = "member-boxes" }
}

resource "aws_secretsmanager_secret_version" "member_box_ssh" {
  for_each      = toset(local.member_box_people)
  secret_id     = aws_secretsmanager_secret.member_box_ssh[each.key].id
  secret_string = tls_private_key.member_box[each.key].private_key_openssh
}

# Only administration and nextjs-dev-role (narrowed per container by its session policy) may read a key.
resource "aws_secretsmanager_secret_policy" "member_box_ssh" {
  for_each   = toset(local.member_box_people)
  secret_arn = aws_secretsmanager_secret.member_box_ssh[each.key].arn
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "OnlyAdministrationAndNextjsDevCanRead"
      Effect    = "Deny"
      Principal = "*"
      Action    = "secretsmanager:GetSecretValue"
      Resource  = aws_secretsmanager_secret.member_box_ssh[each.key].arn
      Condition = { ArnNotLike = { "aws:PrincipalArn" = concat(local.games_mp_admin_principals, [aws_iam_role.nextjs_dev.arn]) } }
    }]
  })
}

# ============================================================ the Linux boxes' own lifetime backstop
# A bash fragment for a member pbox's or gbox's user_data (cloud-init runs it once, at the first boot of a launch):
# write the deadline (that boot plus HOURS) and a systemd timer that checks it at boot and every 15 minutes and powers
# the box off once it has passed; the templates' shutdown behaviour then terminates the instance. A timer, not
# `shutdown -h +N`, because a reboot cancels a pending shutdown. An unreadable deadline counts as passed.
locals {
  member_box_deadline_setup = <<-SH
    BOOT=$(( $(date +%s) - $(cut -d. -f1 /proc/uptime) ))
    [ -s /etc/member-box-deadline ] || echo $(( BOOT + HOURS * 3600 )) > /etc/member-box-deadline
    cat > /usr/local/sbin/member-box-deadline <<'DEADLINE'
    #!/bin/sh
    d=$(cat /etc/member-box-deadline 2>/dev/null)
    case "$d" in ''|*[!0-9]*) d=0 ;; esac
    if [ "$(date +%s)" -ge "$d" ]; then exec /sbin/shutdown -h now "member box lifetime reached"; fi
    DEADLINE
    chmod 755 /usr/local/sbin/member-box-deadline
    printf '[Unit]\nDescription=Member box lifetime backstop\n[Service]\nType=oneshot\nExecStart=/usr/local/sbin/member-box-deadline\n' \
      > /etc/systemd/system/member-box-deadline.service
    printf '[Unit]\nDescription=Member box lifetime backstop\n[Timer]\nOnBootSec=1min\nOnUnitActiveSec=15min\n[Install]\nWantedBy=timers.target\n' \
      > /etc/systemd/system/member-box-deadline.timer
    systemctl daemon-reload
    systemctl enable --now member-box-deadline.timer
  SH
}

# ============================================================ what a session policy has to name
output "member_boxes" {
  description = "Per member: the Name tags, launch templates, volumes, secrets, instance role and fixed private IPs of their own wbox, pbox and gbox (for the per-container session policies)"
  value = {
    for p in local.member_box_people : p => {
      wbox = {
        name             = local.member_wbox_slots[p]
        region           = local.member_wbox_region
        private_ip       = local.member_wbox_ips[p]
        launch_template  = aws_launch_template.member_wbox[p].arn
        data_volume      = aws_ebs_volume.member_wbox_data[p].arn
        password_secret  = aws_secretsmanager_secret.member_wbox_admin[p].arn
        instance_role    = aws_iam_role.member_wbox[p].arn
        instance_profile = aws_iam_instance_profile.member_wbox[p].arn
      }
      pbox = {
        name            = local.member_pbox_slots[p]
        region          = local.member_pbox_region
        private_ip      = local.member_pbox_ips[p]
        launch_template = aws_launch_template.member_pbox[p].arn
        work_volume     = aws_ebs_volume.member_pbox_work[p].arn
        ssh_key_secret  = aws_secretsmanager_secret.member_box_ssh[p].arn
      }
      gbox = {
        name            = local.member_gbox_slots[p]
        region          = local.member_gbox_region
        private_ip      = local.member_gbox_ips[p]
        launch_template = aws_launch_template.member_gbox[p].arn
        ssh_key_secret  = aws_secretsmanager_secret.member_box_ssh[p].arn
      }
    }
  }
}
